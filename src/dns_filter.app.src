{application, dns_filter, [
    {description, "DNS Lookup Agent for the Emergence System"},
    {vsn, "0.2.0"},
    {registered, [dns_filter_sup, dns_filter_server]},
    {mod, {dns_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        dns_filter_sup,
        dns_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/dns_filter"}]}
]}.
